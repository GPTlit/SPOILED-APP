rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'salemmoustapha15@gmail.com' ||
        request.auth.token.email == 'salemmoustapha19@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // App schema validation
    function isValidApp(data) {
      return data.id is string && data.id.size() >= 1 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.category is string && data.category.size() >= 1 &&
             data.developer is string && data.developer.size() >= 1 &&
             data.uploaderUid is string &&
             (!('rating' in data) || data.rating is number) &&
             (!('price' in data) || data.price is number) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // News schema validation
    function isValidNews(data) {
      return data.id is string && data.id.size() >= 1 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.content is string && data.content.size() >= 1 &&
             data.author is string && data.author.size() >= 1 &&
             data.authorUid is string &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // Notification schema validation
    function isValidNotification(data) {
      return data.id is string && data.id.size() >= 1 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.message is string && data.message.size() >= 1 &&
             data.authorUid is string &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // Comment schema validation
    function isValidComment(data) {
      return data.id is string && data.id.size() >= 1 &&
             data.appId is string && data.appId.size() >= 1 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // User schema validation
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() >= 3 &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // Public catalog read and cloud publishing: allows apps to be visible across all devices
    match /apps/{appId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Public news read and publishing
    match /news/{newsId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Public notifications read and broadcast
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Public comments read and posting
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // User profile: only owner can read and write their profile, admin can read
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
